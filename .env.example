# ============================================
# ResearchGroup-Agent 环境变量配置（示例）
# ============================================
# 复制此文件为 .env 并填入实际值

# ---------- LLM 配置 ----------
LLM_API_KEY=sk-your-api-key-here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL_NAME=gpt-4o-mini
ADVISOR_MODEL_NAME=
GRADUATE_MODEL_NAME=
SUBAGENT_MODEL_NAME=
LLM_TIMEOUT=120
LLM_MAX_RETRIES=3

# ---------- 数据库配置 ----------
DATABASE_URL=sqlite:///./researchgroup.db

# ---------- 运行模式 ----------
MOCK_MODE=true

# ---------- 调度器常量 ----------
SCHEDULER_SKILL_WEIGHT=0.7
SCHEDULER_IDLE_WEIGHT=0.3
SCHEDULER_IDLE_SCALE=100
COLLAB_COMPLEXITY_THRESHOLD=7
COLLAB_LOAD_THRESHOLD=0.7
COLLAB_MAX_COUNT=2
SUBAGENT_COMPLEXITY_THRESHOLD=6
SUBAGENT_DECOMPOSABILITY_THRESHOLD=7
SUBAGENT_MENTORING_THRESHOLD=6

# ---------- 服务配置 ----------
BACKEND_PORT=8000
BACKEND_HOST=0.0.0.0
FRONTEND_PORT=3000

# ---------- 日志配置 ----------
LOG_LEVEL=INFO
LOG_DIR=artifacts/logs
