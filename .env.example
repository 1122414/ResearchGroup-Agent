# ============================================
# ResearchGroup-Agent environment
# Copy this file to .env and edit values locally.
# ============================================

# ---------- LLM provider ----------
# true = use deterministic local mock data, no API key required.
# false = use an OpenAI-compatible chat completions API.
MOCK_MODE=true
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL_NAME=gpt-4o-mini
ADVISOR_MODEL_NAME=
GRADUATE_MODEL_NAME=
SUBAGENT_MODEL_NAME=
LLM_TIMEOUT=120
LLM_MAX_RETRIES=3
LLM_MAX_TOKENS=4096
ADVISOR_TEMPERATURE=0.3
GRADUATE_TEMPERATURE=0.7
SUBAGENT_TEMPERATURE=0.7

# Cost estimation in USD per token.
# Defaults below are for gpt-4o-mini. Adjust for your actual model.
# Set to 0 in mock mode (no real API calls).
DEFAULT_INPUT_COST_PER_TOKEN=0.00000015
DEFAULT_OUTPUT_COST_PER_TOKEN=0.00000060
MOCK_INPUT_COST_PER_TOKEN=0
MOCK_OUTPUT_COST_PER_TOKEN=0
TOKEN_ESTIMATE_CHARS_PER_TOKEN=4

# ---------- Database ----------
DATABASE_URL=sqlite:///./researchgroup.db

# ---------- Scheduler ----------
SCHEDULER_SKILL_WEIGHT=0.7
SCHEDULER_IDLE_WEIGHT=0.3
SCHEDULER_IDLE_SCALE=100
COLLAB_COMPLEXITY_THRESHOLD=7
COLLAB_LOAD_THRESHOLD=0.7
COLLAB_MAX_COUNT=2
SUBAGENT_COMPLEXITY_THRESHOLD=6
SUBAGENT_DECOMPOSABILITY_THRESHOLD=7
SUBAGENT_MENTORING_THRESHOLD=6

# ---------- Server / frontend ----------
BACKEND_PORT=8000
BACKEND_HOST=0.0.0.0
FRONTEND_PORT=3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_API_BASE=http://localhost:8000/api
RUN_POLL_INTERVAL_MS=1500
FRONTEND_LOG_FLUSH_INTERVAL_MS=5000

# ---------- Runtime behavior ----------
RUN_CANCEL_CHECK_ENABLED=true
RUN_INTERACTION_MODE=hitl
RUN_EVENT_DEFAULT_LIMIT=100
RUN_EVENT_MAX_LIMIT=500
ATTACHMENT_EXTRACT_MAX_CHARS=12000
ATTACHMENT_MAX_FILE_SIZE_MB=25
MULTIMODAL_ENABLED=false
VISION_MODEL_NAME=
LITERATURE_SOURCE_LIMIT=5
LITERATURE_FALLBACK_SOURCE_COUNT=4
REPORT_TITLE_PREVIEW_CHARS=50
REPORT_OUTPUT_POINT_MAX_CHARS=500
REPORT_OUTPUT_POINT_LIMIT=5
REPORT_EVIDENCE_PAPER_LIMIT=5
RUN_ARTIFACT_TITLE_MAX_LENGTH=28
RUN_ARTIFACT_DEDUPE_LIMIT=100
EVIDENCE_PROVIDER_MODE=auto
EVIDENCE_REMOTE_SEARCH_ENABLED=true
WEB_SEARCH_ENABLED=false
WEB_SEARCH_PROVIDER_MODE=tavily
EVIDENCE_SEARCH_MAX_RESULTS=5
EVIDENCE_EXCERPT_MAX_CHARS=1200
EVIDENCE_STALE_AFTER_YEARS=8
EVIDENCE_PRIMARY_SOURCE_BONUS=0.15
EVIDENCE_PEER_REVIEW_BONUS=0.15
EVIDENCE_LINK_SUPPORT_WEIGHT=1.0
EVIDENCE_LINK_OPPOSE_WEIGHT=1.0
CLAIM_SUPPORT_THRESHOLD=0.65
CLAIM_CONFLICT_THRESHOLD=0.35
TAVILY_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com
TAVILY_SEARCH_DEPTH=basic
CROSSREF_ENABLED=true
CROSSREF_BASE_URL=https://api.crossref.org
CROSSREF_MAILTO=
OPENALEX_ENABLED=true
OPENALEX_BASE_URL=https://api.openalex.org
OPENALEX_MAILTO=
ARXIV_ENABLED=true
ARXIV_BASE_URL=https://export.arxiv.org/api
SEMANTIC_SCHOLAR_ENABLED=false
SEMANTIC_SCHOLAR_BASE_URL=https://api.semanticscholar.org/graph/v1
SEMANTIC_SCHOLAR_API_KEY=
BROWSER_RESEARCH_ENABLED=false
BROWSER_RESEARCH_PROVIDER_MODE=browser_use
BROWSER_VERIFICATION_ENABLED=false
BROWSER_VERIFICATION_REQUIRED=true
BROWSER_USE_MODEL_PROVIDER=openai_compatible
BROWSER_USE_MODEL_NAME=
BROWSER_USE_CONFIG_DIR=artifacts/browser_use/config
BROWSER_USE_HEADLESS=true
BROWSER_USE_MAX_STEPS=12
BROWSER_USE_MAX_CANDIDATES=3
LITERATURE_REQUIRE_GROUNDED_SOURCES=true
LITERATURE_MIN_GROUNDED_SOURCES=2
CITATION_VALIDATION_ENABLED=true

# ---------- Agent skill evolution ----------
AGENT_SKILL_ENABLED=true
SKILL_AUTO_CAPTURE_ENABLED=true
SKILL_DEFAULT_STATUS=draft
SKILL_MIN_CONFIDENCE=0.7
SKILL_MAX_INJECTED=5
SKILL_SENSITIVE_SCAN_ENABLED=true

# ---------- Experiment execution ----------
EXPERIMENT_EXECUTION_ENABLED=false
EXPERIMENT_WORKSPACE_DIR=artifacts/experiment_workspace
EXPERIMENT_EXECUTION_BACKEND=local
EXPERIMENT_COMMAND_TIMEOUT_SECONDS=300
REPRODUCIBLE_EXPERIMENT_TIMEOUT_SECONDS=120
EXPERIMENT_MAX_OUTPUT_CHARS=20000
EXPERIMENT_ALLOW_NETWORK=false
EXPERIMENT_ALLOW_PACKAGE_INSTALL=false
EXPERIMENT_REQUIRE_REVIEW=true
EXPERIMENT_ENV_FILE=
EXPERIMENT_REMOTE_HOST=
EXPERIMENT_REMOTE_PORT=22
EXPERIMENT_DOCKER_IMAGE=
EXPERIMENT_QUEUE_BACKEND=
EXPERIMENT_SUPPORT_BASE_CONFIDENCE=0.6
EXPERIMENT_SUPPORT_MAX_CONFIDENCE=0.95
EXPERIMENT_WEAKEN_CONFIDENCE=0.45
EXPERIMENT_REJECT_CONFIDENCE=0.8
EXPERIMENT_INCONCLUSIVE_FAILURE_CONFIDENCE=0.2
EXPERIMENT_INCONCLUSIVE_MISSING_METRIC_CONFIDENCE=0.3

# ---------- Review heuristics ----------
REVIEW_PASS_THRESHOLD=0.75
REVIEW_DEFAULT_APPROVED_SCORE=0.8
REVIEW_DEFAULT_REJECTED_SCORE=0.55
REVIEW_TRACEABILITY_MISSING_SCORE=0.45
REVIEW_MISSING_SCORE=0.5
REVIEW_REPORT_EVIDENCE_SCORE=0.9
TASK_MAX_REVISION_ROUNDS=2

# ---------- Research loop ----------
RESEARCH_LOOP_AUTO_CONTINUE=true
RESEARCH_LOOP_MAX_AUTO_ROUNDS=1
RESEARCH_LOOP_MAX_TASKS_PER_ROUND=3

# ---------- Logs and artifacts ----------
LOG_LEVEL=INFO
LOG_DIR=artifacts/logs
ARTIFACT_MANIFEST_FILENAME=manifest.json
